# ---------- Server ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------- Database (MongoDB) ----------
# Local development: if MONGODB_URI is unset, the server falls back to
#   mongodb://127.0.0.1:27017/cvision-ai
# (requires a local mongod). You can also set it explicitly:
#   MONGODB_URI=mongodb://127.0.0.1:27017/cvision-ai
#
# Production (Vercel): MONGODB_URI is REQUIRED and must be a remote MongoDB
# Atlas connection string. Localhost/127.0.0.1 URIs are rejected at startup,
# because Vercel has no local MongoDB (that is what caused
# "connect ECONNREFUSED 127.0.0.1:27017").
# Set it in Vercel -> Project Settings -> Environment Variables
# (Production, Preview AND Development) - never commit it to this repo.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# ---------- Auth (JWT) ----------
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse this example value and never commit a real .env file.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---------- Rate limiting (optional overrides) ----------
# Defaults are already conservative: 10 auth attempts and 100 API calls per 15 min.
# Raise these only for local development so the auth flow can be exercised freely.
# AUTH_RATE_LIMIT_MAX=50
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=500
# UPLOAD_RATE_LIMIT_MAX=50

# ---------- OpenRouter (AI provider) ----------
# Server-side only. Get your key from https://openrouter.ai/keys
# Never place this key in a client/.env VITE_* variable.
# Until a real key is set here, CV analysis returns a clear "AI is not
# configured" error instead of guessing a result.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# `openrouter/free` is OpenRouter's free model router: it picks a currently
# available free model, so no paid credits are needed. Replace it with a
# specific model (e.g. `openai/gpt-4o-mini`) if you want a fixed one.
OPENROUTER_MODEL=openrouter/free
# OpenRouter is OpenAI-compatible, so this default is usually left alone.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Per-request timeout in ms. Analysis is a single blocking call.
# OPENROUTER_TIMEOUT_MS=60000
# Upper bound on the tokens requested per analysis.
# OPENROUTER_MAX_TOKENS=6000
# Optional attribution headers. Only sent when set.
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=CVision AI

# ---------- File Uploads (Multer) ----------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
