# ---------- Client ----------
# Vite dev server port
VITE_PORT=5173

# Base URL for API requests (Axios baseURL). It must be the API origin
# followed by /api.
# Local development (two terminals, API on port 5000):
VITE_API_URL=http://localhost:5000/api
# Production build: point at your deployed server instead, e.g.
#   VITE_API_URL=https://your-api-host.example.com/api
# Leave it unset to fall back to "/api" (same-origin requests through the
# Vite dev proxy, see vite.config.js).

# OpenRouter is called server-side only. Never expose the key in VITE_* vars.
