# ---------- Client ----------
# Vite dev server port
VITE_PORT=5173

# API origin - origin ONLY, no trailing /api. The app appends /api itself:
#   ${VITE_API_URL}/api/auth/register
#   ${VITE_API_URL}/api/resumes
# Local development (API on port 5000):
VITE_API_URL=http://localhost:5000
# Production: set the deployed backend origin, e.g.
#   VITE_API_URL=https://your-api-host.example.com
# If unset, requests fall back to http://localhost:5000 (dev only).

# OpenRouter is called server-side only. Never expose the key in VITE_* vars.
