# ---------- Client ----------
# Vite dev server port
VITE_PORT=5173

# Origin of the CVision AI Express API. Vite proxies the /api prefix to this
# target, so the target itself must NOT include /api (that would double the
# prefix and every request would 404).
VITE_API_URL=http://localhost:5000

# OpenRouter is called server-side only. Never expose the key in VITE_* vars.
